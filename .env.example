# Copy this file to `.env` and edit the values. NEVER commit `.env`.
#
# POSTGRES_HOST=postgres is the Docker Compose service name (used from Stage 5).
# While running the backend directly on your machine (Stages 1-4), set
# POSTGRES_HOST=127.0.0.1 in YOUR local .env only.

POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=civicpulse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Which triage provider to use: rules | simulated  (llm and ollama arrive in Stage 2)
TRIAGE_PROVIDER=rules
# Only used by the simulated provider (CI): deterministic seed and injected failure rate 0.0-1.0
SIMULATED_SEED=0
SIMULATED_FAILURE_RATE=0.0
